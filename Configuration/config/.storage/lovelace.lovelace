            {
              "type": "grid",
              "cards": [
                {
                  "type": "markdown",
                  "content": "<h1><center>Battery</center></h1>",
                  "grid_options": {
                    "columns": "full"
                  },
                  "text_only": true
                },
                {
                  "type": "gauge",
                  "entity": "sensor.sigen_inverter_battery_state_of_charge",
                  "needle": false,
                  "severity": {
                    "green": 70,
                    "yellow": 40,
                    "red": 0
                  },
                  "name": " "
                },
                {
                  "type": "gauge",
                  "entity": "sensor.sigen_inverter_battery_power",
                  "needle": true,
                  "max": 13,
                  "grid_options": {
                    "columns": 6,
                    "rows": 3
                  },
                  "severity": {
                    "green": 1,
                    "yellow": 0.00001,
                    "red": 0
                  },
                  "visibility": [
                    {
                      "condition": "state",
                      "entity": "binary_sensor.sigenstore_battery_charging",
                      "state": "on"
                    },
                    {
                      "condition": "numeric_state",
                      "entity": "sensor.sigen_inverter_battery_state_of_charge",
                      "below": 99
                    }
                  ],
                  "name": " "
                },
                {
                  "type": "markdown",
                  "content": "<h2><center>Charging</h2>",
                  "grid_options": {
                    "rows": "auto",
                    "columns": 6
                  },
                  "visibility": [
                    {
                      "condition": "state",
                      "entity": "binary_sensor.sigenstore_battery_charging",
                      "state": "on"
                    },
                    {
                      "condition": "numeric_state",
                      "entity": "sensor.sigen_inverter_battery_state_of_charge",
                      "below": 99
                    }
                  ]
                },
                {
                  "type": "markdown",
                  "content": "<h2><center>{% set h = states('sensor.sigenstore_estimated_battery_charge_duration') | float(0) %}{% set hours = h | int %}{% set mins = ((h - hours) * 60) | round(0) | int %}{{ \"%d:%02d\" | format(hours, mins) }}</center></h2>",
                  "grid_options": {
                    "rows": 1,
                    "columns": 6
                  },
                  "visibility": [
                    {
                      "condition": "state",
                      "entity": "binary_sensor.sigenstore_battery_charging",
                      "state": "on"
                    },
                    {
                      "condition": "numeric_state",
                      "entity": "sensor.sigen_inverter_battery_state_of_charge",
                      "below": 99
                    }
                  ]
                },
                {
                  "type": "markdown",
                  "content": "<h2><center>{{ as_local(as_datetime(states('sensor.sigenstore_estimated_battery_fully_charged_time'))).strftime('%-I:%M %p') }}</center></h2>\n",
                  "grid_options": {
                    "rows": 1,
                    "columns": 6
                  },
                  "visibility": [
                    {
                      "condition": "state",
                      "entity": "binary_sensor.sigenstore_battery_charging",
                      "state": "on"
                    },
                    {
                      "condition": "numeric_state",
                      "entity": "sensor.sigen_inverter_battery_state_of_charge",
                      "below": 99
                    }
                  ]
                },
                {
                  "type": "gauge",
                  "entity": "sensor.sigenstore_battery_power_inverted",
                  "needle": true,
                  "max": 13,
                  "grid_options": {
                    "columns": 6,
                    "rows": 3
                  },
                  "name": " ",
                  "severity": {
                    "green": 0,
                    "yellow": 0,
                    "red": 2
                  },
                  "visibility": [
                    {
                      "condition": "state",
                      "entity": "binary_sensor.sigenstore_battery_discharging",
                      "state": "on"
                    },
                    {
                      "condition": "numeric_state",
                      "entity": "sensor.sigen_inverter_battery_state_of_charge",
                      "below": 99
                    }
                  ]
                },
                {
                  "type": "markdown",
                  "content": "<h2><center>Discharging<center></h2>\n",
                  "grid_options": {
                    "rows": "auto",
                    "columns": 6
                  },
                  "visibility": [
                    {
                      "condition": "state",
                      "entity": "binary_sensor.sigenstore_battery_discharging",
                      "state": "on"
                    },
                    {
                      "condition": "numeric_state",
                      "entity": "sensor.sigen_inverter_battery_state_of_charge",
                      "below": 99
                    }
                  ]
                },
                {
                  "type": "markdown",
                  "content": "<h2><center>{% set h = states('sensor.sigenstore_estimated_battery_discharge_duration') | float(0) %}{% set hours = h | int %}{% set mins = ((h - hours) * 60) | round(0) | int %}{{ \"%d:%02d\" | format(hours, mins) }}</center></h2>\n",
                  "grid_options": {
                    "rows": "auto",
                    "columns": 6
                  },
                  "visibility": [
                    {
                      "condition": "state",
                      "entity": "binary_sensor.sigenstore_battery_discharging",
                      "state": "on"
                    },
                    {
                      "condition": "numeric_state",
                      "entity": "sensor.sigen_inverter_battery_state_of_charge",
                      "below": 99
                    }
                  ]
                },
                {
                  "type": "markdown",
                  "content": "<h2><center>{{ as_local(as_datetime(states('sensor.sigenstore_estimated_battery_discharged_time'))).strftime('%-I:%M %p') }}</center></h2>\n",
                  "grid_options": {
                    "rows": "auto",
                    "columns": 6
                  },
                  "visibility": [
                    {
                      "condition": "state",
                      "entity": "binary_sensor.sigenstore_battery_discharging",
                      "state": "on"
                    }
                  ]
                },
                {
                  "type": "markdown",
                  "content": "<h1><center>Consumption</center></h1>",
                  "grid_options": {
                    "columns": "full"
                  },
                  "text_only": true
                },
                {
                  "type": "gauge",
                  "entity": "sensor.sigenstore_consumed_power",
                  "needle": true,
                  "max": 11,
                  "name": " "
                },
                {
                  "type": "markdown",
                  "content": "<h1><center>Free Power!</center></h1>",
                  "grid_options": {
                    "columns": "full"
                  },
                  "visibility": [
                    {
                      "condition": "time",
                      "after": "11:00:00",
                      "before": "14:00:00"
                    }
                  ]
                },
                {
                  "type": "markdown",
                  "content": "<h1><center>Solar</center></h1>",
                  "grid_options": {
                    "columns": "full"
                  },
                  "text_only": true
                },
                {
                  "type": "gauge",
                  "entity": "sensor.sigenstore_pv_power",
                  "needle": true,
                  "max": 11,
                  "name": " "
                }
              ],
              "column_span": 1,
              "background": {
                "opacity": 50
              }
            },
