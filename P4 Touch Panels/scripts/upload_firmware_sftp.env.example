# Copy to upload_firmware_sftp.env (same directory) and set your values.
#   cp scripts/upload_firmware_sftp.env.example scripts/upload_firmware_sftp.env
# upload_firmware_sftp.env is gitignored — do not commit real passwords.
#
# Override path: UPLOAD_FIRMWARE_ENV_FILE=/path/to/other.env ./scripts/upload_firmware_sftp.sh
#
# Quote passwords that contain &, #, <, >, spaces, etc. (single quotes are safest).

SFTP_HOST=ssh.nyc1.nearlyfreespeech.net
SFTP_USER=your_username
SFTP_PASSWORD='change_me'

# Directory on the server (relative to SFTP login home unless you use a leading /).
SFTP_REMOTE_DIR=root/ha/fware/esphmi

# Optional:
# SFTP_PORT=22
